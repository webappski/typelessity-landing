{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/typelessity-landing/browser",
  "routes": [
    {
      "src": "^/industries(?:/(?:automotive-detailing|automotive-test-drives|beauty-nail-salons|beauty-spas|beauty-tattoo-studios|education-language-schools|education-music-schools|education-test-prep|fitness-martial-arts|fitness-personal-training|fitness-sports-coaching|home-cleaning|home-handyman|home-hvac|home-landscaping|home-moving|hospitality-event-venues|hospitality-hotels|hospitality-tours|pet-grooming|pet-training|pet-veterinary|professional-accounting|professional-coaching|professional-financial-advisors|professional-legal|realestate-commercial|realestate-property-management|realestate-residential|beauty-aesthetic-clinics|beauty-hair-salons|hospitality-restaurants|fitness-yoga-studios|fitness-gyms|automotive-driving-schools|automotive-repair|education-tutoring))?/?$",
      "status": 410,
      "dest": "/404.html",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cal.com https://typelessity-widget.vercel.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://typelessity-widget.vercel.app; connect-src 'self' https://api.resend.com https://*.supabase.co https://cal.com https://typelessity.vercel.app; frame-src https://cal.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/legal/privacy",
      "destination": "https://webappski.com/en/legal/dpa-typelessity",
      "permanent": true
    },
    {
      "source": "/legal/terms",
      "destination": "https://webappski.com/en/legal/terms-typelessity",
      "permanent": true
    },
    {
      "source": "/legal/dpa",
      "destination": "https://webappski.com/en/legal/dpa-typelessity",
      "permanent": true
    },
    {
      "source": "/legal/sub-processors",
      "destination": "https://webappski.com/en/legal/dpa-typelessity",
      "permanent": true
    },
    {
      "source": "/blog/gdpr-compliance",
      "destination": "/gdpr",
      "permanent": true
    },
    {
      "source": "/blog/what-we-got-wrong",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/forms-vs-conversation-study",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cal.com https://typelessity-widget.vercel.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://typelessity-widget.vercel.app; connect-src 'self' https://api.resend.com https://*.supabase.co https://cal.com https://typelessity.vercel.app; frame-src https://cal.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/fonts.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/((?!fonts/fonts\\.css$).*)\\.(js|css|woff2|jpg|png|svg|webp|avif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap(.*)\\.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
