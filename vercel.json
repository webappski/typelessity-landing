{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/typelessity-landing/browser",
  "routes": [
    {
      "src": "^/(.*)/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "^/industries(?:/(?:automotive-detailing|automotive-test-drives|beauty-nail-salons|beauty-spas|beauty-tattoo-studios|education-language-schools|education-music-schools|education-test-prep|fitness-martial-arts|fitness-personal-training|fitness-sports-coaching|home-cleaning|home-handyman|home-hvac|home-landscaping|home-moving|hospitality-event-venues|hospitality-hotels|hospitality-tours|pet-grooming|pet-training|pet-veterinary|professional-accounting|professional-coaching|professional-financial-advisors|professional-legal|realestate-commercial|realestate-property-management|realestate-residential|beauty-aesthetic-clinics|beauty-hair-salons|hospitality-restaurants|fitness-yoga-studios|fitness-gyms|automotive-driving-schools|automotive-repair|education-tutoring))?/?$",
      "status": 410,
      "dest": "/404.html",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), geolocation=(), microphone=(self)",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cal.com https://typelessity-widget.vercel.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://typelessity-widget.vercel.app; connect-src 'self' https://api.resend.com https://*.supabase.co https://cal.com https://typelessity.vercel.app; frame-src https://cal.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      }
    },
    {
      "src": "^/blog/(?:what-we-got-wrong|forms-vs-conversation-study)/?$",
      "status": 410,
      "dest": "/404.html",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), geolocation=(), microphone=(self)",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cal.com https://typelessity-widget.vercel.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://typelessity-widget.vercel.app; connect-src 'self' https://api.resend.com https://*.supabase.co https://cal.com https://typelessity.vercel.app; frame-src https://cal.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      }
    },
    {
      "src": "^/legal/privacy$",
      "headers": {
        "Location": "/privacy"
      },
      "status": 308
    },
    {
      "src": "^/legal/terms$",
      "headers": {
        "Location": "https://webappski.com/en/legal/terms-typelessity"
      },
      "status": 308
    },
    {
      "src": "^/legal/dpa$",
      "headers": {
        "Location": "https://webappski.com/en/legal/dpa-typelessity"
      },
      "status": 308
    },
    {
      "src": "^/legal/sub-processors$",
      "headers": {
        "Location": "https://webappski.com/en/legal/dpa-typelessity"
      },
      "status": 308
    },
    {
      "src": "^/blog/gdpr-compliance$",
      "headers": {
        "Location": "/gdpr"
      },
      "status": 308
    },
    {
      "src": "^(?:/(.*))$",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), geolocation=(), microphone=(self)",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cal.com https://typelessity-widget.vercel.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://typelessity-widget.vercel.app; connect-src 'self' https://api.resend.com https://*.supabase.co https://cal.com https://typelessity.vercel.app; frame-src https://cal.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "^/fonts(?:/(.*))\\.woff2$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/fonts/fonts\\.css$",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      },
      "continue": true
    },
    {
      "src": "^(?:/((?:main|chunk|polyfills|styles)-[A-Z0-9]{8}))\\.(js|css)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^(?:/([^/]+))\\.(jpg|png|svg|webp|avif|ico)$",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "^/sitemap(.*)\\.xml$",
      "headers": {
        "Cache-Control": "public, max-age=3600, s-maxage=86400",
        "Content-Type": "application/xml; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/llms\\.txt$",
      "headers": {
        "Cache-Control": "public, max-age=3600, s-maxage=86400",
        "Content-Type": "text/plain; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/robots\\.txt$",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
